#!/usr/bin/env node
'use strict';

// cc-sessions — inventory, search, and resume Claude Code sessions across every
// environment (Terminal, VSCode, Cursor, Superset, …). Thin CLI: parse args, load the
// session list, dispatch to a renderer. All real logic lives in ../lib.

const fs = require('fs');
const { spawnSync } = require('child_process');

const { HOME, PROJECTS_DIR, SESSIONS_DIR, HTML_PATH } = require('../lib/config');
const { loadRegistry } = require('../lib/registry');
const { collect, applyFilters } = require('../lib/sessions');
const { renderJson } = require('../lib/render/json');
const { renderTable } = require('../lib/render/table');
const { renderHtml } = require('../lib/render/html');

const HELP = `
cc-sessions — inventory & search Claude Code sessions

Usage:
  cc-sessions                       Print sessions newest-first (terminal table)
  cc-sessions --limit 30            Show top 30
  cc-sessions --grep "WAYVE"        Filter by first-prompt / summary / cwd (case-insensitive)
  cc-sessions --cwd coveralls       Filter by cwd slug (substring)
  cc-sessions --since 2026-05-01    Only sessions modified on/after date
  cc-sessions --html                Generate HTML report and open in browser
  cc-sessions --json                JSON output (for scripts)
  cc-sessions --resume              Interactive fzf picker; prints resume command
  cc-sessions --help                This message

The HTML report supports live filtering and column sorting in-browser.
Each invocation re-scans the filesystem — always shows current state.
`;

function parseArgs(argv) {
  const opts = {
    limit: null,
    grep: null,
    cwdFilter: null,
    since: null,
    format: 'table',
    resume: false,
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--limit') opts.limit = parseInt(argv[++i], 10);
    else if (a === '--grep') opts.grep = argv[++i];
    else if (a === '--cwd') opts.cwdFilter = argv[++i];
    else if (a === '--since') opts.since = new Date(argv[++i]);
    else if (a === '--html') opts.format = 'html';
    else if (a === '--json') opts.format = 'json';
    else if (a === '--resume') opts.resume = true;
    else if (a === '--help' || a === '-h') {
      console.log(HELP);
      process.exit(0);
    } else {
      console.error(`Unknown arg: ${a}\nUse --help`);
      process.exit(2);
    }
  }
  return opts;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));

  const registry = loadRegistry(SESSIONS_DIR);
  const all = collect(PROJECTS_DIR, registry);
  const filtered = applyFilters(all, opts);

  if (opts.format === 'json') {
    console.log(renderJson(filtered));
    return;
  }

  if (opts.format === 'html') {
    const html = renderHtml(all, filtered);
    fs.writeFileSync(HTML_PATH, html);
    console.log(`Wrote ${HTML_PATH} (${filtered.length} sessions)`);
    spawnSync('open', [HTML_PATH], { stdio: 'inherit' });
    return;
  }

  if (opts.resume) {
    const which = spawnSync('which', ['fzf']);
    if (which.status !== 0) {
      console.error('fzf not installed. Install: brew install fzf');
      process.exit(1);
    }
    const fzfInput = filtered
      .map(
        (s) =>
          `${s.uuid}\t${s.mtime.toISOString().slice(0, 16)}\t${(s.cwd || '').replace(HOME, '~')}\t${(s.firstPrompt || '').slice(0, 120)}`
      )
      .join('\n');
    const result = spawnSync(
      'fzf',
      [
        '--delimiter=\t',
        '--with-nth=2,3,4',
        '--height=80%',
        '--reverse',
        '--header=Select session to resume (Enter), Esc to cancel',
      ],
      { input: fzfInput, encoding: 'utf8', stdio: ['pipe', 'pipe', 'inherit'] }
    );
    if (result.stdout && result.stdout.trim()) {
      const uuid = result.stdout.split('\t')[0];
      const session = filtered.find((s) => s.uuid === uuid);
      if (session) console.log(`cd ${session.resumeCwd || session.cwd} && claude --resume ${uuid}`);
    }
    return;
  }

  // Default: terminal table
  console.log(renderTable(all, filtered));
}

main();
